# PulseStream Environment Configuration

# Kafka
# In-Docker communication uses kafka:9092. Host machine uses localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_EVENTS_TOPIC=pulsestream.events
KAFKA_DLQ_TOPIC=pulsestream.events.dlq
KAFKA_CONSUMER_GROUP=ps-aggregation

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pulsestream
POSTGRES_USER=pulsestream
POSTGRES_PASSWORD=pulsestream
# POSTGRES_DSN=postgresql://pulsestream:pulsestream@localhost:5432/pulsestream

# Logging & Monitoring
LOG_LEVEL=INFO
ENVIRONMENT=development
METRICS_PORT=9100

# Ingestion Service
INGESTION_WIKIPEDIA_ENABLED=true
INGESTION_WIKIPEDIA_URL=https://stream.wikimedia.org/v2/stream/recentchange
INGESTION_SIMULATOR_ENABLED=true
INGESTION_SIMULATOR_MODE=steady
INGESTION_SIMULATOR_RATE=50
INGESTION_CHAOS_DUPLICATE_PCT=0.05
INGESTION_CHAOS_MALFORMED_PCT=0.02
